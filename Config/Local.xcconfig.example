// Copy this file to Config/Local.xcconfig (ignored by git) and edit it.
// Pick ONE of the two options.

// Option 1: sign with your Apple Developer team.
// Find the ID in Xcode > Settings > Accounts, or at developer.apple.com > Membership.
DEVELOPMENT_TEAM = YOUR_TEAM_ID

